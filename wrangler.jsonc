{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "anniversary",
  "compatibility_date": "2026-08-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
